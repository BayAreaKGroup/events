#!/bin/sh
# Repo-wide pre-commit gate: max-600-lines (all staged files), no new JS in
# knight2026/src, prettier format check + oxlint + tsc for staged TS/TSX.
# Bootstrapped via `knight2026/package.json`'s "prepare" script:
#   git config core.hooksPath .githooks
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged_files" ] && exit 0

fail=0

# 1) Universal max-600-lines guard — covers root index.html/404.html too,
#    not just knight2026 TS (oxlint's max-lines rule below is the
#    authoritative TS-specific check; this is a cheap, dependency-free
#    backstop for everything else).
while IFS= read -r f; do
  [ -z "$f" ] && continue
  [ -f "$f" ] || continue
  case "$f" in
    */node_modules/*|*/.next/*|*/out/*|*package-lock.json|*.tsbuildinfo|*.svg|*.png|*.jpg|*.jpeg) continue ;;
  esac
  lines="$(wc -l < "$f" | tr -d ' ')"
  if [ "$lines" -gt 600 ]; then
    echo "pre-commit: $f has $lines lines (max 600)"
    fail=1
  fi
done <<EOF
$staged_files
EOF

# 2) No new .js/.jsx under knight2026/src (TypeScript-only source).
new_js="$(git diff --cached --name-only --diff-filter=A -- 'knight2026/src/**/*.js' 'knight2026/src/**/*.jsx' || true)"
if [ -n "$new_js" ]; then
  echo "pre-commit: new JS files are not allowed in knight2026/src (TypeScript only):"
  echo "$new_js"
  fail=1
fi

# 3) knight2026 TS/TSX: prettier format check + oxlint + tsc, staged files only.
ts_staged="$(printf '%s\n' "$staged_files" | grep -E '^knight2026/src/.*\.(ts|tsx)$' || true)"
if [ -n "$ts_staged" ]; then
  rel="$(printf '%s\n' "$ts_staged" | sed 's#^knight2026/##')"

  if [ -x knight2026/node_modules/.bin/prettier ]; then
    if ! (cd knight2026 && ./node_modules/.bin/prettier --check $(printf '%s\n' "$rel" | tr '\n' ' ')); then
      echo "pre-commit: prettier check failed — run: (cd knight2026 && npm run format)"
      fail=1
    fi
  fi

  if [ -x knight2026/node_modules/.bin/oxlint ]; then
    if ! (cd knight2026 && ./node_modules/.bin/oxlint $(printf '%s\n' "$rel" | tr '\n' ' ')); then
      echo "pre-commit: oxlint failed."
      fail=1
    fi
  fi

  if [ -x knight2026/node_modules/.bin/tsc ]; then
    if ! (cd knight2026 && ./node_modules/.bin/tsc --noEmit); then
      echo "pre-commit: tsc --noEmit failed."
      fail=1
    fi
  fi
fi

exit "$fail"
